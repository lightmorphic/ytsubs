#!/bin/bash
# Everything needed to draw the window ships inside this AppImage: Qt's
# WebEngine, the Qt platform plugins, and the Python packages. Nothing gets
# installed on the host and nothing is checked for -- earlier versions used
# the host's GTK WebKit2 and asked to install it when missing, which is
# exactly the thing an AppImage is supposed to spare you.
#
# The one thing still taken from the host is python3 itself, which every
# Linux desktop ships. It has to be 3.10 or newer, because the bundled Qt
# wheels are built against that ABI.
set -e
HERE="$(dirname "$(readlink -f "${0}")")"

PY="$(command -v python3 || true)"

dialog_tool() {
  if command -v zenity >/dev/null 2>&1; then echo zenity
  elif command -v kdialog >/dev/null 2>&1; then echo kdialog
  elif command -v xmessage >/dev/null 2>&1; then echo xmessage
  else echo none
  fi
}

show_message() {
  case "$(dialog_tool)" in
    zenity) zenity --error --title="YT Subs" --width=360 --text="$1" ;;
    kdialog) kdialog --title "YT Subs" --error "$1" ;;
    xmessage) xmessage -center "$1" ;;
    *) echo "$1" >&2 ;;
  esac
}

if [ -z "$PY" ] || ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
  show_message "YT Subs needs Python 3.10 or newer on this system.\n\nEvery current Linux desktop ships one; if yours doesn't, install your distribution's python3 package."
  exit 1
fi

export PYTHONPATH="$HERE/usr/lib/pyapp${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

# Chromium's own sandbox needs unprivileged user namespaces, which several
# distributions restrict by default -- where they're off, it doesn't degrade,
# it refuses to start. The page it renders is our own local UI, so the sandbox
# buys nothing here and its absence costs nothing.
export QTWEBENGINE_DISABLE_SANDBOX=1

exec "$PY" "$HERE/usr/app/app.py" "$@"
